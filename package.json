{
  "name": "pip-demo-replica",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "Experimental macOS screen recorder and demo editor; a partial Screen Studio workflow recreation using a shared MIT-licensed engine.",
  "homepage": "https://github.com/Ghostzy0/pip-demo-replica",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "22.22.1",
    "npm": "10.9.4"
  },
  "author": {
    "name": "Ghostzy0",
    "url": "https://github.com/Ghostzy0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ghostzy0/pip-demo-replica.git"
  },
  "contributors": [
    {
      "name": "Siddharth Vaddem",
      "url": "https://github.com/siddharthvaddem"
    }
  ],
  "scripts": {
    "dev": "npm run dev:replica",
    "build": "npm run build:replica",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "i18n:check": "node scripts/i18n-check.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "licenses:generate": "node scripts/generate-third-party-licenses.mjs",
    "preview": "vite preview",
    "build:mac": "npm run build:native:demo && npm run build:replica",
    "build:native:compositor:mac": "node scripts/build-macos-compositor-addon.mjs",
    "build:whisper-binaries": "bash scripts/build-whisper-stt.sh",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:sck-audio-timeline:mac": "node scripts/test-macos-audio-timeline.mjs",
    "test:swift:mac": "swift test --package-path electron/native/screencapturekit",
    "build-vite": "tsc && vite build",
    "cli": "electron .",
    "prepare": "node -e \"process.exit(0)\"",
    "fetch:ffmpeg:mac": "node scripts/fetch-ffmpeg-macos.mjs",
    "fetch:onnxruntime": "node scripts/fetch-onnxruntime.mjs",
    "build:replica": "node scripts/build-edition.mjs replica",
    "build:native:demo": "npm run fetch:camera && node scripts/build-macos-screencapturekit-helper.mjs && node scripts/fetch-ffmpeg-macos.mjs && node scripts/fetch-onnxruntime.mjs && node scripts/build-macos-compositor-addon.mjs && bash scripts/build-whisper-stt.sh",
    "dev:replica": "VITE_DEMO_PRODUCT=replica VITE_DEMO_APPEARANCE=baseline VITE_DEMO_EXTRAS=core vite --host 127.0.0.1 --port 5197 --strictPort",
    "fetch:camera": "node scripts/camera-assets.mjs"
  },
  "dependencies": {
    "@fix-webm-duration/fix": "^1.0.1",
    "@langchain/anthropic": "^1.3.26",
    "@langchain/core": "^1.1.44",
    "@langchain/mistralai": "^1.0.8",
    "@langchain/openai": "^1.4.2",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
